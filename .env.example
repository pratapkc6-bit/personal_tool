# Optional Zoro cloud reasoning.
# OpenAI API usage is metered unless your API project has credits.
# Keep this secret server-side only. Never prefix it with NEXT_PUBLIC_.
OPENAI_API_KEY=""
# Low-cost default for normal Zoro conversations.
OPENAI_MODEL="gpt-6-luna"
# Optional stronger model for complex planning. Leave blank to keep all requests on OPENAI_MODEL.
# Example: OPENAI_SMART_MODEL="gpt-6-sol"
OPENAI_SMART_MODEL=""
